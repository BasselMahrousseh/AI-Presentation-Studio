            "objects": [
                {
                    "object_id": "deployment_yaml",
                    "type": "text",
                    "role": "code_snippet",
                    "text": "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: backend-api\nspec:\n  replicas: 3\n  selector:\n    matchLabels:\n      app: backend-api\n  template:\n    metadata:\n      labels:\n        app: backend-api\n    spec:\n      containers:\n      - name: api\n        image: backend-api:v1",
                    "data": null,
